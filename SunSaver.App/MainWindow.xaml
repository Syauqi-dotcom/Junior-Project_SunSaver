<Window x:Class="SunSaver.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SunSaver — Estimasi Potensi Surya &amp; Jejak Karbon"
        Width="1360" Height="860" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource Latar}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Background="{StaticResource Sidebar}">
            <DockPanel Margin="16,24">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,32">
                    <!-- Tanda matahari sederhana -->
                    <Grid Width="26" Height="26" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#F59E0B"/>
                        <Ellipse Width="24" Height="24" Stroke="#F59E0B" StrokeThickness="1.5"
                                 StrokeDashArray="1.5 2.2"/>
                    </Grid>
                    <TextBlock Text="SunSaver" Foreground="White" FontSize="20" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="8,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Garjita Adicandra" Foreground="White" FontSize="13"/>
                        <TextBlock Text="Pemilik rumah" Foreground="#71717A" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="MENU" Foreground="#52525B" FontSize="11" Margin="8,0,0,8"/>
                    <RadioButton x:Name="NavDashboard" Content="Dashboard" GroupName="Nav"
                                 Style="{StaticResource ItemNavigasi}" IsChecked="True"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavInstalasi" Content="Instalasi Saya" GroupName="Nav"
                                 Style="{StaticResource ItemNavigasi}"
                                 Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ KONTEN ============ -->
        <ContentControl x:Name="Konten" Grid.Column="1"/>
    </Grid>
</Window>
